# Secrets only.  Every non-secret -- hostname, database name, which role each
# service connects as -- lives in docker-compose.yml, so there is exactly one
# place to look for each kind of thing and no chance of the two disagreeing.
#
# Compose reads this file on the HOST at parse time to resolve ${VAR} in
# docker-compose.yml.  It is NOT mounted into any container and is NOT passed
# with env_file, so a container receives only the keys its service enumerates.

## Postgres superuser.  Created by the postgis image on first initialization,
## and used by the loader service, which runs DDL.
POSTGIS_ROOT_PASSWORD=""

## Application role passwords.  SET BY sql/010_roles.sql, which the loader runs;
## hail_ingest then uses its own value to connect as the ingest service.
HAIL_INGEST_PASSWORD=""
HAIL_APP_PASSWORD=""

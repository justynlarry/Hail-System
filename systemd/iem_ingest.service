[Unit]
Description=Nightly IEM Local Storm Report ingest
Documentation=file:///home/hail-user/hail-system/docs/hail-consolidated.md

# Container runtime has to be up prior to this service doing anything.
# Requires= instead of Wants= -> No degraded Mode, if Docker isn't running
# the run can't start

Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot

User=hail-user
Group=hail-user

WorkingDirectory=/home/hail-user/hail-system
Environment=HOME=/home/hail-user

ExecStart=/usr/bin/docker compose run --rm ingest python3 scripts/iem_ingest.py

TimeoutStartSec=900

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
